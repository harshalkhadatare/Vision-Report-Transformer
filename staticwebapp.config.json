{
  "platform": {
    "apiRuntime": "node:20"
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "/images/*",
      "*.{css,js,json,png,jpg,jpeg,gif,svg,ico,mp4,webm,woff,woff2,ttf,eot}"
    ]
  },
  "routes": [
    { "route": "/*.sql", "statusCode": 404 },
    { "route": "/*.py", "statusCode": 404 },
    { "route": "/*.md", "statusCode": 404 }
  ],
  "globalHeaders": {
    "Cache-Control": "public, max-age=0, must-revalidate",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "mimeTypes": {
    ".mp4": "video/mp4",
    ".json": "application/json",
    ".sql": "text/plain"
  }
}
